# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# API backend (local dev)
VITE_API_URL=http://localhost:8000

# Google Calendar Integration
# See the Accounts page in the app for full setup instructions.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Never put a secret in a VITE_ variable: anything the code reads from one is
# baked into the public website bundle. Tokens (GitHub, OpenAI, …) belong on
# the server — connect GitHub from the Accounts page instead.
