# Copy to .env for local dev, or .env.production on the droplet.
# Never commit either — they contain real secrets.

# ── Required: the server refuses to start without these three ────────────────
# (set ATLAS_ALLOW_INSECURE_CONFIG=1 to start anyway — local development only)

# Who is allowed to log in (comma-separated Google emails). Empty = nobody.
ALLOWED_EMAILS=will@woodwardweb.com

# CORS: origins allowed to call the API
# Local:      http://localhost:5173
# Production: https://<github-username>.github.io
ALLOWED_ORIGINS=http://localhost:5173

# Your Google OAuth client ID (same one used for Google Calendar). Sign-in
# checks each Google token was issued to this client.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# JWT signing secret, 32+ characters — generate: openssl rand -hex 32
# Changing it signs out every device.
JWT_SECRET=replace_with_64_random_chars

# MCP API key — generate: openssl rand -hex 16
# Sent as "Authorization: Bearer <key>". Accepting it as ?key= in the URL (it
# then lands in logs) is off unless a client can't send headers:
# ATLAS_MCP_ALLOW_QUERY_KEY=on
ATLAS_MCP_KEY=replace_with_32_random_chars

# Browser helper (helper/ in the repo, runs on your laptop). It connects out to
# /api/browser/helper with this key. Unset = no helper can connect.
# Generate one with: openssl rand -hex 32
BROWSER_HELPER_KEY=replace_with_64_random_hex_chars

# Interactive API docs (/docs, /redoc, /openapi.json) are off in production.
# ATLAS_API_DOCS=on

# How much spending detail the assistant may read over MCP.
# The agent container talks to a third-party model, so merchant-level history
# leaves the box the moment this is on. Off by default, deliberately.
#   off      — list_transactions is not offered at all
#   redacted — dates, amounts and categories, but no merchant names
#   full     — everything
# Aggregates (get_finances_summary) are always available and never itemised.
ATLAS_MCP_TRANSACTIONS=off

# SQLite file path inside the container
DATABASE_PATH=/data/atlas.db

# ── Assistant (Strands agent container) ──────────────────────────────────────
# API key for the model provider
OPENAI_API_KEY=sk-...
AGENT_MODEL_ID=gpt-6-luna
# Model for auto-categorising transactions (defaults to AGENT_MODEL_ID).
# FINANCE_CLASSIFY_MODEL=gpt-6-luna
# Coding delegation (clone, commit, push, open PRs). OFF unless set to "on".
# When off, the tool isn't offered to the model, refuses if called anyway, and
# GITHUB_PAT is stripped from the agent's environment at startup.
ATLAS_AGENT_CODING=off
# Where the agent reaches the MCP server, and where the api proxies the agent.
# Both are Docker-internal service names — do not point these at public URLs.
ATLAS_MCP_URL=http://api:8000/mcp/sse
AGENT_URL=http://agent:8100
TZ=Europe/London
TAVILY_API_KEY=tvly-...
# Research subagents run at once. Lower if runs stall in rate-limit backoff.
RESEARCH_MAX_CONCURRENT=5
